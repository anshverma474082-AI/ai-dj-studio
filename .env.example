# Copy to .env and fill in real values. Never commit .env (PRD §10.1, §14.2).

# --- Application ---
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# --- Database (local Homebrew Postgres; `brew services start postgresql@16`) ---
# Replace USER with your local Postgres role. Homebrew defaults to your macOS username,
# which usually needs no password over a local socket.
DATABASE_URL=postgresql+asyncpg://USER@localhost:5432/ai_dj_studio

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=45
REFRESH_TOKEN_TTL_DAYS=7

# --- AI DJ / RAG (PRD §8.1: document which model you used and why) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- Frontend (Vite reads only VITE_-prefixed vars) ---
VITE_API_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000
